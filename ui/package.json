{
  "name": "@moul-dev/ui",
  "version": "2026.08.17",
  "description": "Accessible, zero-runtime React component library built on React Aria and StyleX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/moul-ui.js",
  "module": "./dist/moul-ui.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moul-dev/ui.git",
    "directory": "ui"
  },
  "homepage": "https://moul.dev/ui",
  "bugs": {
    "url": "https://github.com/moul-dev/ui/issues"
  },
  "keywords": [
    "react",
    "react-aria",
    "stylex",
    "components",
    "accessible",
    "design-system",
    "zero-runtime",
    "ui"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/moul-ui.js"
    },
    "./style": {
      "style": "./dist/assets/stylex.css",
      "default": "./dist/assets/stylex.css"
    },
    "./style.css": {
      "style": "./dist/assets/stylex.css",
      "default": "./dist/assets/stylex.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "input-otp": "^1.4.2",
    "react-aria": "^3.50.0",
    "react-aria-components": "^1.19.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^3.23.2",
    "glob": "^11.0.0",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^2.1.8"
  }
}
