{
  "name": "moul-ui-workspace",
  "private": true,
  "version": "2026.08.27",
  "workspaces": [
    "ui",
    "docs"
  ],
  "scripts": {
    "build": "bun run build:ui && bun run build:docs",
    "build:ui": "bun --cwd ui build",
    "build:docs": "bun --cwd docs build",
    "test": "bun --cwd ui test",
    "test:ui": "bun --cwd ui test",
    "types:check": "bun --cwd ui tsc -b && bun --cwd docs types:check",
    "dev:ui": "bun --cwd ui dev",
    "dev:docs": "bun --cwd docs dev",
    "dev": "bun scripts/dev.ts",
    "gen:component": "bun scripts/gen-component.ts",
    "sync:llms": "bun scripts/sync-llms.ts",
    "bump": "bun scripts/bump-version.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "bun scripts/setup-hooks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  }
}
