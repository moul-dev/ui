---
/**
 * The Phase 5 and Phase 6 gates: a landing page with a hero, a logo row, a
 * features grid and a call to action, built from Moul elements alone, where
 * every section also has a background or light drawn in CSS and SVG. The
 * page loads the main and effects entries and carries no animation code of
 * its own: no keyframes, no transitions, no script beyond the two imports.
 * Every piece of motion and light is an element or an attribute.
 */
import '@moul-dev/web-component/style.css'

const frameworks = [
  'Astro',
  'Vue',
  'Svelte',
  'React 19',
  'Lit',
  'Solid',
  'Angular',
  'Plain HTML',
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Landing page example · Moul UI</title>
    <meta
      name="description"
      content="A landing page built from Moul UI elements alone, with no hand-written animation."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
    />
  </head>
  <body>
    <moul-scroll-progress></moul-scroll-progress>

    <header class="nav">
      <a class="brand" href="/">Moul UI</a>
      <nav aria-label="Main">
        <moul-link href="/docs/">Docs</moul-link>
        <moul-link href="/docs/landing-kit/">Landing kit</moul-link>
        <moul-link href="/theme/">Theme</moul-link>
      </nav>
      <moul-theme-toggle></moul-theme-toggle>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <moul-spotlight class="layer"></moul-spotlight>
        <moul-pattern class="layer" variant="grid" fade="radial" is-animated count="10"></moul-pattern>

        <a class="pill" href="/docs/landing-kit/">
          <moul-gradient-text effect="shine">New: the landing kit</moul-gradient-text>
          <span aria-hidden="true">→</span>
        </a>

        <h1 id="hero-title">
          <moul-text-entrance by="words">Web components for</moul-text-entrance>
          <moul-word-rotate words='["dashboards","landing pages","AI chat","admin consoles"]'>dashboards</moul-word-rotate>
        </h1>

        <moul-reveal delay="300">
          <p class="lede">
            Plain HTML tags that work in any framework, with
            <moul-highlight delay="900">motion built in</moul-highlight>
            and switched off for readers who ask for less.
          </p>
        </moul-reveal>

        <moul-reveal delay="450" class="actions">
          <moul-button size="lg" effect="shimmer">
            Get started
            <span slot="hover">Read the docs →</span>
          </moul-button>
          <moul-button size="lg" variant="outline">View on GitHub</moul-button>
        </moul-reveal>

        <moul-reveal delay="600" distance="40" class="showcase">
          <moul-border-beam>
            <moul-browser-frame url="moul.dev/admin">
              <div class="screen">
                <div class="screen-stats">
                  <moul-stat label="Requests" value="128430" trend="up" trend-value="+8%"></moul-stat>
                  <moul-stat label="Error rate" value="0.4" suffix="%" trend="down" trend-value="-0.2%" tone="success"></moul-stat>
                  <moul-stat label="p95 latency" value="182" suffix=" ms"></moul-stat>
                </div>
                <moul-terminal label="zsh">
                  <moul-terminal-line is-command>bun add @moul-dev/web-component</moul-terminal-line>
                  <moul-terminal-line tone="success">installed @moul-dev/web-component</moul-terminal-line>
                </moul-terminal>
              </div>
            </moul-browser-frame>
          </moul-border-beam>
          <moul-backlight class="phone" blur="28">
            <moul-phone-frame>
              <moul-aurora variant="blobs" class="phone-screen">
                <strong>Today</strong>
                <moul-stat label="Sign-ups" value="342"></moul-stat>
                <moul-stat label="Revenue" value="4820" prefix="$"></moul-stat>
              </moul-aurora>
            </moul-phone-frame>
          </moul-backlight>
        </moul-reveal>
      </section>

      <section class="logos" aria-labelledby="logos-title">
        <moul-pattern class="layer" variant="dots" fade="edges"></moul-pattern>
        <h2 id="logos-title" class="eyebrow">Works wherever HTML works</h2>
        <moul-marquee fade-edges pause-on-hover>
          {frameworks.map((name) => <span class="wordmark">{name}</span>)}
        </moul-marquee>
      </section>

      <section class="features" aria-labelledby="features-title">
        <moul-light-rays class="layer" count="9"></moul-light-rays>
        <moul-reveal>
          <h2 id="features-title">
            Everything a product page needs,
            <moul-gradient-text>nothing it does not</moul-gradient-text>
          </h2>
        </moul-reveal>

        <moul-reveal stagger="90">
          <moul-bento-grid columns="3">
            <moul-bento-card col-span="2" effect="spotlight glow">
              <div slot="visual" class="visual visual-code" aria-hidden="true">
                <moul-code-block language="html">{`<moul-text-entrance by="words">
  Web components for
</moul-text-entrance>`}</moul-code-block>
              </div>
              <h3 slot="heading">Motion as markup</h3>
              Text effects, reveals and marquees are attributes, not scripts.
              <moul-link slot="action" href="/docs/landing-kit/">See the kit →</moul-link>
            </moul-bento-card>
            <moul-bento-card row-span="2" effect="spotlight">
              <div slot="visual" class="visual visual-phone" aria-hidden="true">
                <moul-phone-frame variant="android" class="mini-phone">
                  <div class="phone-screen"><moul-stat label="Orders" value="58"></moul-stat></div>
                </moul-phone-frame>
              </div>
              <h3 slot="heading">Phone and browser frames</h3>
              Show the product in context with frames drawn in CSS.
              <moul-link slot="action" href="/docs/components/phoneframe/">Frames →</moul-link>
            </moul-bento-card>
            <moul-bento-card effect="spotlight">
              <moul-ripple slot="visual" class="visual visual-ripple" count="4" aria-hidden="true">
                <span class="ripple-mark">Aa</span>
              </moul-ripple>
              <h3 slot="heading">Reduced motion, always</h3>
              Every effect has a still version for readers who ask for less.
              <moul-link slot="action" href="/docs/landing-kit/#accessibility">Accessibility →</moul-link>
            </moul-bento-card>
            <moul-bento-card effect="spotlight">
              <div slot="visual" class="visual visual-orbit" aria-hidden="true">
                <moul-orbit radius="52" duration="24" show-path>
                  <span class="swatch swatch-1"></span>
                  <span class="swatch swatch-2"></span>
                  <span class="swatch swatch-3"></span>
                  <span class="swatch swatch-4"></span>
                  <span class="swatch swatch-5"></span>
                  <span slot="center" class="swatch swatch-accent"></span>
                </moul-orbit>
              </div>
              <h3 slot="heading">
                <moul-scramble>Light and dark</moul-scramble>
              </h3>
              Colours come from tokens, so both themes work without extra CSS.
              <moul-link slot="action" href="/theme/">Theme studio →</moul-link>
            </moul-bento-card>
          </moul-bento-grid>
        </moul-reveal>
      </section>

      <section class="cta" aria-labelledby="cta-title">
        <moul-perspective-grid class="layer"></moul-perspective-grid>
        <moul-reveal>
          <h2 id="cta-title">
            Ship your <moul-highlight effect="underline" tone="primary">landing page</moul-highlight> this week
          </h2>
        </moul-reveal>
        <moul-reveal delay="150">
          <moul-shine-border class="command">
            <p class="cta-command">
              <moul-typewriter text="bun add @moul-dev/web-component"></moul-typewriter>
            </p>
          </moul-shine-border>
        </moul-reveal>
        <moul-reveal delay="300" class="actions">
          <moul-button size="lg" effect="rainbow" is-pulsing>Start building</moul-button>
        </moul-reveal>
      </section>
    </main>

    <footer class="footer">
      <span>Built with Moul UI elements only, with no animation code of its own.</span>
      <moul-link href="/docs/landing-kit/">How this page is made</moul-link>
    </footer>

    <script>
      import '@moul-dev/web-component'
      import '@moul-dev/web-component/effects'
    </script>
  </body>
</html>

<style is:global>
  /* Layout and type only. Motion and light come from the elements. */
  html {
    background: var(--color-background);
    color: var(--color-fg);
    font-family: 'Google Sans', var(--font-family-base, system-ui), sans-serif;
  }

  body {
    margin: 0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-6, 1.5rem);
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--spacing-4, 1rem) var(--spacing-6, 1.5rem);
  }

  .nav nav {
    display: flex;
    gap: var(--spacing-4, 1rem);
    margin-inline-start: auto;
  }

  .brand {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  /* Sections run the full width, so their backgrounds do, while the padding
     keeps the content in a 72rem column. Each holds its background layers. */
  main > section {
    position: relative;
    isolation: isolate;
    padding: var(--spacing-16, 4rem) max(var(--spacing-6, 1.5rem), (100% - 72rem) / 2);
  }

  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  main > section + section {
    border-top: 1px solid var(--color-border-subtle);
  }

  .hero {
    text-align: center;
  }

  .pill {
    display: inline-flex;
    gap: var(--spacing-2, 0.5rem);
    padding: var(--spacing-1, 0.25rem) var(--spacing-3, 0.75rem);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-fg-subtle);
    font-size: var(--font-size-sm, 0.875rem);
    text-decoration: none;
  }

  h1 {
    margin: var(--spacing-6, 1.5rem) auto var(--spacing-4, 1rem);
    max-width: 18ch;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  h2 {
    margin: 0 0 var(--spacing-8, 2rem);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .lede {
    max-width: 36rem;
    margin: 0 auto;
    color: var(--color-fg-subtle);
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-3, 0.75rem);
    margin-top: var(--spacing-8, 2rem);
  }

  .showcase {
    position: relative;
    margin-top: var(--spacing-12, 3rem);
  }

  .screen {
    display: grid;
    gap: var(--spacing-4, 1rem);
    padding: var(--spacing-6, 1.5rem);
    background: var(--color-bg-subtle);
    text-align: start;
  }

  .screen-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--spacing-4, 1rem);
  }

  .phone {
    position: absolute;
    inset-inline-end: -1rem;
    bottom: -3rem;
    --phone-frame-width: 12.5rem;
  }

  .phone-screen {
    display: grid;
    box-sizing: border-box;
    align-content: start;
    gap: var(--spacing-3, 0.75rem);
    height: 100%;
    padding: var(--spacing-10, 2.5rem) var(--spacing-3, 0.75rem) var(--spacing-3, 0.75rem);
    background: var(--color-bg-subtle);
    text-align: start;
  }

  @media (max-width: 48rem) {
    .phone {
      display: none;
    }
  }

  .eyebrow {
    margin-bottom: var(--spacing-6, 1.5rem);
    color: var(--color-fg-subtle);
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wordmark {
    color: var(--color-fg-subtle);
    font-size: 1.5rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .visual {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--spacing-6, 1.5rem) var(--spacing-6, 1.5rem) 0;
    background: var(--color-bg-subtle);
  }

  .visual-phone {
    align-items: end;
  }

  .visual-ripple {
    min-height: 12rem;
    padding: 0;
    overflow: hidden;
    --ripple-size: 5rem;
    --ripple-gap: 2.5rem;
    --ripple-color: var(--color-accent);
  }

  .ripple-mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    font-weight: 700;
  }

  .visual-orbit {
    padding: var(--spacing-6, 1.5rem);
    --orbit-item-size: 1.25rem;
  }

  .swatch {
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .swatch-1 { background: var(--color-chart-1); }
  .swatch-2 { background: var(--color-chart-2); }
  .swatch-3 { background: var(--color-chart-3); }
  .swatch-4 { background: var(--color-chart-4); }
  .swatch-5 { background: var(--color-chart-5); }

  .swatch-accent {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-accent);
  }

  .visual-code moul-code-block {
    width: 100%;
  }

  .mini-phone {
    --phone-frame-width: 8rem;
  }

  .features h3 {
    margin: 0;
    font-size: 1.125rem;
  }

  .cta {
    text-align: center;
  }

  .command {
    display: inline-block;
    border-radius: 999px;
  }

  .cta-command {
    padding: var(--spacing-3, 0.75rem) var(--spacing-6, 1.5rem);
    margin: 0;
    color: var(--color-fg-subtle);
    font-family: var(--font-family-mono, monospace);
    font-size: 1.125rem;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--spacing-4, 1rem);
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--spacing-8, 2rem) var(--spacing-6, 1.5rem);
    border-top: 1px solid var(--color-border);
    color: var(--color-fg-subtle);
    font-size: var(--font-size-sm, 0.875rem);
  }
</style>
