---
// Overrides Starlight's SiteTitle with the Moul lockup: the faceted mark in
// the accent color, the title, and a Beta chip. The mark follows
// --brand-hue, so it retints live in Theme Studio.
import Logo from './Logo.astro'

// This tsconfig doesn't load Starlight's locals types; name the fields used.
const { siteTitle, siteTitleHref } = (
  Astro.locals as {
    starlightRoute: { siteTitle: string; siteTitleHref: string }
  }
).starlightRoute
---

<a href={siteTitleHref} class="site-title" translate="no">
  <Logo class="brand-mark" />
  <span class="brand-title">{siteTitle}</span>
  <span class="brand-chip">Beta</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fg);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-xl);
  }

  .site-title:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .site-title :global(.brand-mark) {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-accent);
  }

  .brand-title {
    font-size: var(--sl-text-base);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-chip {
    padding: 0.0625rem 0.375rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 25%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    font-family: var(--font-family-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
