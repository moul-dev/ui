---
// The Moul mark: four facets of a split diamond. Fills with currentColor so
// callers tint it; facet opacities match public/favicon.svg.
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<svg
  class:list={['moul-logo', className]}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M 11.6 2.25 L 3.5 11.25 L 9.4 13.5 Z" opacity="0.88" />
  <path d="M 12.2 2.25 L 20.3 11.25 L 10.0 13.5 Z" />
  <path d="M 11.6 21.85 L 3.5 11.95 L 9.4 14.2 Z" opacity="0.65" />
  <path d="M 12.2 21.85 L 20.3 11.95 L 10.0 14.2 Z" opacity="0.8" />
</svg>
