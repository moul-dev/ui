---
/**
 * Notification bell demo wiring, so the MDX previews stay plain markup:
 *   data-bell-notify="id"  → click adds the next sample notification to #id,
 *                            unread, and raises its count
 *   data-bell-read         → on a control inside a bell, marks every
 *                            notification read and sets the count to 0
 *   data-bell-dismiss      → on a control inside a notification, removes it
 *                            with `removeItem()`, lowering the count if it
 *                            was unread, and keeps focus in the panel
 * It also styles the `.demo-bell-item` rows the previews use.
 */
---

<style is:global>
  .demo-bell-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.25rem 0.5rem 0.75rem;
    border-radius: var(--radius-xl);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-sm);
  }

  .demo-bell-item[data-unread] {
    background: color-mix(in oklab, var(--color-accent) 8%, transparent);
  }

  .demo-bell-item-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
  }

  .demo-bell-item-text span {
    color: var(--color-fg-subtle);
    font-size: var(--font-size-xs);
  }

  .demo-bell-item[data-unread] strong::after {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin-inline-start: 0.375rem;
    vertical-align: middle;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }

  .demo-bell-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }
</style>

<script>
  import type { MoulNotificationBell } from '@moul-dev/web-component'

  const SAMPLES = [
    ['Payment received', '$49.00 · Pro plan'],
    ['Disk 80% full', 'db-primary'],
    ['Job failed', 'nightly-backup · exit 1'],
    ['New comment', 'Vanna on “Roadmap”'],
  ] as const
  let next = 0

  function notification(): HTMLElement {
    const [title, detail] = SAMPLES[next++ % SAMPLES.length]
    const row = document.createElement('div')
    row.className = 'demo-bell-item'
    row.toggleAttribute('data-unread', true)
    row.innerHTML = `<span class="demo-bell-item-text"><strong></strong><span></span></span><moul-button size="sm" variant="ghost" is-icon aria-label="Dismiss" data-bell-dismiss>✕</moul-button>`
    row.querySelector('strong')!.textContent = title
    row.querySelector('.demo-bell-item-text span')!.textContent = detail
    return row
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null
    const control = target?.closest?.<HTMLElement>(
      '[data-bell-notify], [data-bell-read], [data-bell-dismiss]',
    )
    if (!control) return

    if (control.dataset.bellNotify) {
      const bell = document.getElementById(
        control.dataset.bellNotify,
      ) as MoulNotificationBell | null
      if (!bell) return
      bell.prepend(notification())
      bell.count += 1
      return
    }

    const bell = control.closest<MoulNotificationBell>('moul-notification-bell')
    if (!bell) return
    if (control.hasAttribute('data-bell-read')) {
      for (const row of bell.querySelectorAll('[data-unread]')) {
        row.removeAttribute('data-unread')
      }
      bell.count = 0
      return
    }

    const row = control.closest<HTMLElement>('.demo-bell-item')
    if (!row) return
    if (row.hasAttribute('data-unread')) bell.count = Math.max(0, bell.count - 1)
    // Keep focus in the panel: on the next row's dismiss button, or the panel.
    const rows = [...bell.querySelectorAll<HTMLElement>('.demo-bell-item')]
    const neighbour = rows[rows.indexOf(row) + 1] ?? rows[rows.indexOf(row) - 1]
    const dismiss = neighbour?.querySelector<HTMLElement>('[data-bell-dismiss]')
    // A moul-button takes focus on the native button inside it.
    const nextFocus = dismiss?.shadowRoot?.querySelector('button') ?? bell.panelEl
    nextFocus?.focus()
    void bell.removeItem(row)
  })
</script>
