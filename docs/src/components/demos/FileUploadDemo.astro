---
/**
 * File upload demo: a pretend upload that waits a moment (the bar is
 * indeterminate), reports progress in steps, stops when Cancel aborts its
 * signal, and fails every third attempt so Retry has something to do.
 * Nothing leaves the browser.
 */
---

<moul-file-upload
  data-file-upload-demo
  label="Attachments"
  description="Images or PDFs, up to 5 MB each, at most 4 files. Uploads here are simulated."
  accept="image/*,.pdf"
  max-size="5242880"
  max-files="4"
  is-multiple
  style="width: min(100%, 28rem)"></moul-file-upload>

<script>
  import type {
    FileUploadContext,
    MoulFileUpload,
  } from '@moul-dev/web-component'

  let attempts = 0

  function pretendUpload(
    file: File,
    { signal, onProgress }: FileUploadContext,
  ): Promise<unknown> {
    const fails = ++attempts % 3 === 0
    return new Promise((resolve, reject) => {
      let percent = 0
      let timer: ReturnType<typeof setTimeout>
      const step = () => {
        percent += 8 + Math.random() * 14
        if (fails && percent > 55) {
          reject(new Error('The connection dropped.'))
        } else if (percent >= 100) {
          onProgress(100)
          resolve({ name: file.name, size: file.size })
        } else {
          onProgress(percent)
          timer = setTimeout(step, 180)
        }
      }
      timer = setTimeout(step, 700)
      signal.addEventListener('abort', () => {
        clearTimeout(timer)
        reject(signal.reason)
      })
    })
  }

  for (const field of document.querySelectorAll<MoulFileUpload>(
    '[data-file-upload-demo]',
  )) {
    field.upload = pretendUpload
  }
</script>
