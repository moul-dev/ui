---
/**
 * CanvasLoopController demo: a field of drifting particles on a 2D canvas,
 * sharp at any pixel ratio, paused off screen, and still under reduced motion.
 */
---

<effects-demo-particles>
  <canvas aria-hidden="true"></canvas>
  <p class="particles-status" aria-live="off"></p>
</effects-demo-particles>

<style is:global>
  effects-demo-particles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    width: min(100%, 32rem);
    color: var(--color-accent);
  }

  effects-demo-particles canvas {
    display: block;
    width: 100%;
    height: 14rem;
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  effects-demo-particles .particles-status {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-fg-subtle);
  }
</style>

<script>
  import { CanvasLoopController, type CanvasFrame } from '@moul-dev/web-component/effects'
  import { DemoHost, defineDemo } from './demo-host'

  interface Particle {
    x: number
    y: number
    radius: number
    speed: number
    phase: number
  }

  /** Repeatable pseudo-random numbers, so the still frame is the same on every visit. */
  function seeded(seed: number): () => number {
    let a = seed
    return () => {
      a = (a + 0x6d2b79f5) | 0
      let t = Math.imul(a ^ (a >>> 15), 1 | a)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }
  }

  class ParticlesDemo extends DemoHost {
    private particles: Particle[] = []
    private color = 'currentColor'

    loop = new CanvasLoopController(this, {
      canvas: () => this.querySelector('canvas'),
      resize: (frame) => this.seed(frame),
      draw: (frame) => this.draw(frame),
    })

    private seed(frame: CanvasFrame): void {
      const { width, height } = frame
      const random = seeded(11)
      const count = Math.round((width * height) / 1400)
      this.particles = Array.from({ length: count }, () => ({
        x: random() * width,
        y: random() * height,
        radius: 0.6 + random() * 1.8,
        speed: 6 + random() * 18,
        phase: random() * Math.PI * 2,
      }))
      this.color = getComputedStyle(this).color
      this.report(frame.pixelRatio)
    }

    private draw({ context, width, height, time, frame }: CanvasFrame): void {
      if (!context) return
      // Follow a theme switch without reading styles on every frame.
      if (frame % 60 === 0) this.color = getComputedStyle(this).color
      context.clearRect(0, 0, width, height)
      context.fillStyle = this.color
      const seconds = time / 1000
      for (const p of this.particles) {
        const y = (p.y - p.speed * seconds) % height
        const x = p.x + Math.sin(seconds + p.phase) * 6
        context.globalAlpha = 0.35 + 0.5 * Math.abs(Math.sin(seconds * 0.8 + p.phase))
        context.beginPath()
        context.arc(x, y < 0 ? y + height : y, p.radius, 0, Math.PI * 2)
        context.fill()
      }
      context.globalAlpha = 1
    }

    private report(pixelRatio: number): void {
      const status = this.querySelector('.particles-status')
      if (!status) return
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
      status.textContent = `${this.particles.length} particles at ${pixelRatio}× pixel ratio${
        reduced ? ' · still frame for reduced motion' : ' · pauses when scrolled away or the tab is hidden'
      }`
    }
  }

  defineDemo('effects-demo-particles', ParticlesDemo)
</script>
