---
// Overrides Starlight's Hero for the splash home pages: copy, install snippet
// and actions on the left, the 3D glass mark on the right, over a grid that
// lights up around the cursor. Brand colors derive from --brand-hue and
// --brand-chroma-multiplier, so Theme Studio retints the whole hero.
//
// Frontmatter: `hero.title` may hold a <span> for the gradient second line,
// `hero.tagline` may hold inline HTML, and `heroBadge` labels the version pill.
import { Icon } from '@astrojs/starlight/components'
import type { ComponentProps } from 'astro/types'
import uiPackage from '../../../ui/package.json'
import InstallCommand from './InstallCommand.astro'
import Logo3D from './Logo3D.astro'

interface HeroAction {
  text: string
  link: string
  variant: 'primary' | 'secondary' | 'minimal'
  icon?: { name?: ComponentProps<typeof Icon>['name']; html?: string }
  attrs?: Record<string, string | number | boolean | undefined>
}

// This tsconfig doesn't load Starlight's locals types; name the fields used.
const { entry, locale } = (
  Astro.locals as {
    starlightRoute: {
      locale: string | undefined
      entry: {
        data: {
          title: string
          heroBadge?: string
          hero?: { title?: string; tagline?: string; actions?: HeroAction[] }
        }
      }
    }
  }
).starlightRoute
const { data } = entry
const { title = data.title, tagline, actions = [] } = data.hero ?? {}
const changelogHref = `${locale ? `/${locale}` : ''}/changelog/`
---

<div class="home-hero">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-grid">
      <div class="hero-grid-lines"></div>
      <div class="hero-grid-lines is-lit"></div>
      <div class="hero-grid-glow"></div>
    </div>
    <div class="hero-aura"></div>
  </div>

  <div class="hero-copy">
    <a class="hero-badge" href={changelogHref}>
      <span class="hero-badge-dot"></span>
      <span class="hero-badge-version">v{uiPackage.version}</span>
      {
        data.heroBadge && (
          <>
            <span class="hero-badge-dash" aria-hidden="true">
              —
            </span>
            <span>{data.heroBadge}</span>
          </>
        )
      }
    </a>

    {/* Starlight's skip link and page-title hooks target #_top. */}
    <h1 id="_top" class="hero-title" data-page-title set:html={title} />
    {tagline && <p class="hero-tagline" set:html={tagline} />}

    <InstallCommand packageName={uiPackage.name} />

    {
      actions.length > 0 && (
        <div class="hero-actions">
          {actions.map(({ text, link, variant, icon, attrs }) => (
            <a
              href={link}
              class:list={['hero-action', `is-${variant}`]}
              {...attrs}
            >
              {variant !== 'primary' && icon?.name && (
                <Icon name={icon.name} size="1.125rem" />
              )}
              {text}
              {variant === 'primary' && icon?.name && (
                <Icon name={icon.name} size="1.125rem" />
              )}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="hero-visual">
    <Logo3D />
  </div>
</div>

<script>
  // Track the cursor over the hero grid so the lit layer follows it.
  const grid = document.querySelector<HTMLElement>('.hero-grid')
  let frame = 0
  if (grid && matchMedia('(hover: hover)').matches) {
    window.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame)
      frame = requestAnimationFrame(() => {
        const rect = grid.getBoundingClientRect()
        const x = event.clientX - rect.left
        const y = event.clientY - rect.top
        const inside = x >= 0 && y >= 0 && x <= rect.width && y <= rect.height
        grid.style.setProperty('--mouse-x', `${x}px`)
        grid.style.setProperty('--mouse-y', `${y}px`)
        grid.style.setProperty('--mouse-opacity', inside ? '1' : '0')
      })
    })
    document.documentElement.addEventListener('pointerleave', () => {
      grid.style.setProperty('--mouse-opacity', '0')
    })
  }
</script>

<style>
  .home-hero {
    --hero-brand: oklch(
      0.75 calc(0.18 * var(--brand-chroma-multiplier, 1)) var(--brand-hue, 250)
    );

    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(2rem, 1rem + 8vmin, 7rem);
  }

  @media (min-width: 64rem) {
    .home-hero {
      grid-template-columns: 7fr 5fr;
      gap: 2rem;
    }
  }

  /* ── Backdrop: full-bleed grid + aura ── */
  .hero-backdrop {
    position: absolute;
    z-index: -1;
    inset-block: calc(-1 * (var(--sl-nav-height) + 1.5rem)) 0;
    left: 50%;
    width: 100vw;
    translate: -50% 0;
    pointer-events: none;
  }

  .hero-grid {
    --mouse-x: 0px;
    --mouse-y: 0px;
    --mouse-opacity: 0;

    position: absolute;
    inset: 0;
    /* Fade the grid out before it reaches the logo. */
    mask-image: linear-gradient(to bottom, #000 25%, transparent 55%);
  }

  @media (min-width: 64rem) {
    .hero-grid {
      mask-image: linear-gradient(to right, #000 40%, transparent 68%);
    }
  }

  .hero-grid-lines,
  .hero-grid-glow {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(
      ellipse 60% 50% at 50% 0%,
      #000 70%,
      transparent 100%
    );
  }

  .hero-grid-lines {
    --line: light-dark(rgb(128 128 128 / 0.07), rgb(255 255 255 / 0.035));
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .hero-grid-lines.is-lit {
    --line: light-dark(
      color-mix(in oklab, var(--hero-brand) 30%, transparent),
      color-mix(in oklab, var(--hero-brand) 40%, transparent)
    );
    opacity: calc(var(--mouse-opacity) * 0.9);
    mask-image: radial-gradient(
      250px circle at var(--mouse-x) var(--mouse-y),
      #000 20%,
      transparent 100%
    );
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-grid-glow {
    background: radial-gradient(
      320px circle at var(--mouse-x) var(--mouse-y),
      light-dark(
        color-mix(in oklab, var(--hero-brand) 12%, transparent),
        color-mix(in oklab, var(--hero-brand) 18%, transparent)
      ),
      transparent 80%
    );
    opacity: calc(var(--mouse-opacity) * 0.75);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-aura {
    position: absolute;
    top: -10rem;
    left: calc(50% - 30rem);
    width: min(72rem, 120vw);
    aspect-ratio: 1155 / 678;
    background: linear-gradient(
      to top right,
      oklch(
        0.78 calc(0.14 * var(--brand-chroma-multiplier, 1)) var(--brand-hue, 250) /
          0.12
      ),
      oklch(
        0.7 calc(0.1 * var(--brand-chroma-multiplier, 1))
          calc(var(--brand-hue, 250) - 15) / 0.08
      )
    );
    filter: blur(64px);
    rotate: 30deg;
    translate: -50% 0;
  }

  /* ── Copy ── */
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .hero-copy {
      align-items: flex-start;
      text-align: start;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--color-surface) 30%, transparent);
    box-shadow: inset 0 0 0 1px
      color-mix(in oklab, var(--color-separator) 60%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    color: var(--color-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.5rem;
    text-decoration: none;
    transition: box-shadow 0.3s ease;
  }

  .hero-badge:hover {
    box-shadow: inset 0 0 0 1px var(--color-separator);
  }

  .hero-badge:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .hero-badge-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--hero-brand);
  }

  .hero-badge-version {
    color: var(--color-fg);
    font-family: var(--font-family-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.025em;
  }

  .hero-badge-dash {
    opacity: 0.6;
  }

  .hero-title {
    max-width: 48rem;
    margin: 0;
    color: var(--color-fg);
    font-size: clamp(2.25rem, 1.25rem + 4vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .hero-title:lang(km) {
    line-height: 1.45;
    letter-spacing: 0;
  }

  /* The gradient second line comes from a <span> in hero.title. */
  .hero-title :global(span) {
    display: block;
    background-image: linear-gradient(
      to right,
      light-dark(
        oklch(
          0.56 calc(0.19 * var(--brand-chroma-multiplier, 1))
            calc(var(--brand-hue, 250) - 5)
        ),
        oklch(
          0.72 calc(0.17 * var(--brand-chroma-multiplier, 1))
            calc(var(--brand-hue, 250) - 5)
        )
      ),
      light-dark(
        oklch(
          0.64 calc(0.18 * var(--brand-chroma-multiplier, 1))
            calc(var(--brand-hue, 250) + 10)
        ),
        oklch(
          0.78 calc(0.16 * var(--brand-chroma-multiplier, 1))
            calc(var(--brand-hue, 250) + 10)
        )
      ),
      light-dark(
        oklch(
          0.56 calc(0.16 * var(--brand-chroma-multiplier, 1))
            calc(var(--brand-hue, 250) - 15)
        ),
        oklch(
          0.72 calc(0.14 * var(--brand-chroma-multiplier, 1))
            calc(var(--brand-hue, 250) - 15)
        )
      )
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-tagline {
    max-width: 40rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--sl-text-lg);
    line-height: 1.75;
  }

  .hero-tagline :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }

  .hero-tagline :global(a) {
    color: var(--color-fg);
    font-weight: 600;
    text-decoration-color: var(--hero-brand);
    text-underline-offset: 0.25em;
  }

  .hero-tagline :global(a:hover) {
    opacity: 0.75;
  }

  /* ── Actions: pill buttons ── */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.5rem;
    border-radius: var(--radius-full);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.25rem;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-smooth);
  }

  .hero-action:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .hero-action.is-primary {
    background: var(--color-accent);
    color: var(--color-accent-fg);
    box-shadow: 0 4px 12px -2px
      color-mix(in oklab, var(--color-accent) 35%, transparent);
  }

  .hero-action.is-primary:hover {
    background: var(--color-accent-hover);
    box-shadow: 0 8px 20px -4px
      color-mix(in oklab, var(--color-accent) 45%, transparent);
    transform: translateY(-2px);
  }

  .hero-action:not(.is-primary) {
    background: color-mix(in oklab, var(--color-surface) 50%, transparent);
    box-shadow:
      inset 0 0 0 1px var(--color-separator),
      0 1px 2px rgb(0 0 0 / 0.04);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    color: var(--color-fg);
  }

  .hero-action:not(.is-primary):hover {
    background: var(--color-default);
  }

  .hero-action:active {
    transform: scale(var(--press-scale));
  }

  @media (min-width: 64rem) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-action:hover {
      transform: none;
    }
  }
</style>
