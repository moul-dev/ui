---
// docs/src/components/ThemeInspector.astro
// Live editor for the four brand hooks. Controls and previews are Moul
// components on the sandbox's white surface cards, so every token change
// shows up in the controls themselves too.

const TOKENS = [
  {
    token: '--brand-hue',
    label: 'Brand hue (OKLCH)',
    min: 0,
    max: 360,
    step: 1,
    value: 250,
    help: 'Rotates the primary color around the OKLCH wheel, 0° to 360°.',
  },
  {
    token: '--brand-chroma-multiplier',
    label: 'Chroma multiplier',
    min: 0,
    max: 2,
    step: 0.05,
    value: 1,
    help: 'Scales saturation from monochrome (0×) to vivid (2×).',
  },
  {
    token: '--brand-radius-factor',
    label: 'Radius factor',
    min: 0,
    max: 2,
    step: 0.1,
    value: 1,
    help: 'Adjusts corner curvature from sharp (0×) to rounded (2×).',
  },
  {
    token: '--brand-density-factor',
    label: 'Density factor',
    min: 0.75,
    max: 1.5,
    step: 0.05,
    value: 1,
    help: 'Scales padding and spacing for compact or spacious layouts.',
  },
]

const defaultCss = `:root {\n${TOKENS.map((t) => `  ${t.token}: ${t.value};`).join('\n')}\n}`
---

<div class="theme-inspector-root not-content">
  <p class="theme-lead">
    Tune Moul UI's design token layer in real time. Adjust brand hue,
    saturation (chroma), border radius, and spatial density, then copy the CSS.
    Every component on this page, the controls included, follows along in both
    light and dark color schemes.
  </p>

  <div class="theme-grid">
    <aside class="theme-card theme-controls">
      <header class="theme-card-header">
        <h2 class="theme-card-title">Design tokens</h2>
        <moul-button id="reset-theme-btn" size="sm" variant="ghost">Reset</moul-button>
      </header>

      <div class="theme-controls-body">
        {
          TOKENS.map((t) => (
            <div class="theme-control">
              <moul-slider
                class="token-slider"
                label={t.label}
                min={t.min}
                max={t.max}
                step={t.step}
                value={t.value}
                data-token={t.token}
                data-default={t.value}
              />
              <p class="control-help">{t.help}</p>
            </div>
          ))
        }
      </div>

      <div class="theme-css">
        <div class="theme-css-header">
          <span class="theme-label">Generated CSS</span>
          <moul-button id="copy-css-btn" size="sm" variant="secondary">Copy CSS</moul-button>
        </div>
        <pre class="theme-css-code"><code id="css-snippet">{defaultCss}</code></pre>
      </div>
    </aside>

    <div class="theme-previews">
      <section class="theme-card">
        <span class="theme-label">Buttons & badges</span>
        <div class="preview-row">
          <moul-button variant="primary">Primary</moul-button>
          <moul-button variant="secondary">Secondary</moul-button>
          <moul-button variant="outline">Outline</moul-button>
          <moul-button variant="ghost">Ghost</moul-button>
          <moul-button variant="danger">Danger</moul-button>
        </div>
        <div class="preview-row">
          <moul-badge tone="primary">Primary</moul-badge>
          <moul-badge tone="accent">Accent</moul-badge>
          <moul-badge tone="success">Success</moul-badge>
          <moul-badge tone="warning">Warning</moul-badge>
          <moul-badge tone="error">Error</moul-badge>
          <moul-toggle-button-group selected-key="week">
            <moul-toggle-button value="day">Day</moul-toggle-button>
            <moul-toggle-button value="week">Week</moul-toggle-button>
            <moul-toggle-button value="month">Month</moul-toggle-button>
          </moul-toggle-button-group>
        </div>
      </section>

      <section class="theme-card">
        <span class="theme-label">Card & alert</span>
        <moul-alert
          tone="accent"
          title="Theme tokens applied"
          description="Colors, border radii, and internal padding follow the active token settings."
        ></moul-alert>
        <div class="preview-surface">
          <moul-card>
            <moul-card-header><strong>Active workspace</strong></moul-card-header>
            <moul-card-body>
              Card surfaces inherit the current radius and spacing scale.
            </moul-card-body>
            <moul-card-footer>
              <div class="preview-row">
                <moul-button size="sm">Manage</moul-button>
                <moul-button size="sm" variant="outline">Settings</moul-button>
              </div>
            </moul-card-footer>
          </moul-card>
        </div>
      </section>

      <section class="theme-card">
        <span class="theme-label">Inputs & progress</span>
        <moul-text-field
          label="Organization handle"
          placeholder="e.g. moul-dev"
          description="Unique identifier for workspace resources."
        ></moul-text-field>
        <moul-switch is-checked>Enable preview deployments</moul-switch>
        <moul-progress-bar value="75" show-label label="Deployment progress"></moul-progress-bar>
      </section>
    </div>
  </div>
</div>

<script>
  import '@moul-dev/ui'

  type TokenSlider = HTMLElement & { value: number }

  const sliders = [
    ...document.querySelectorAll<TokenSlider>('.token-slider'),
  ]
  const snippet = document.getElementById('css-snippet')
  const copyBtn = document.getElementById('copy-css-btn')
  const resetBtn = document.getElementById('reset-theme-btn')

  function applyTokens(): void {
    const lines = sliders.map((slider) => {
      const token = slider.dataset.token ?? ''
      document.documentElement.style.setProperty(token, String(slider.value))
      return `  ${token}: ${slider.value};`
    })
    if (snippet) snippet.textContent = `:root {\n${lines.join('\n')}\n}`
  }

  for (const slider of sliders) {
    slider.addEventListener('input', applyTokens)
  }

  resetBtn?.addEventListener('click', () => {
    for (const slider of sliders) {
      slider.value = Number(slider.dataset.default)
    }
    applyTokens()
  })

  copyBtn?.addEventListener('click', async () => {
    if (!snippet || !copyBtn) return
    try {
      await navigator.clipboard.writeText(snippet.textContent ?? '')
      copyBtn.textContent = 'Copied!'
      setTimeout(() => {
        copyBtn.textContent = 'Copy CSS'
      }, 2000)
    } catch {
      copyBtn.textContent = 'Failed'
    }
  })
</script>

<style>
  .theme-inspector-root {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0 4rem;
    color: var(--color-fg);
  }

  .theme-lead {
    max-width: 48rem;
    margin: 0 0 2rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-text);
  }

  .theme-grid {
    display: grid;
    grid-template-columns: 22rem 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 56rem) {
    .theme-grid {
      grid-template-columns: 1fr;
    }
  }

  /* The sandbox's demo group: white surface, soft shadow, no border. */
  .theme-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-surface);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .theme-controls {
    position: sticky;
    top: calc(var(--sl-nav-height) + 1rem);
  }

  @media (max-width: 56rem) {
    .theme-controls {
      position: static;
    }
  }

  .theme-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .theme-card-title {
    margin: 0;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .theme-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .theme-controls-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .theme-control {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .control-help {
    margin: 0;
    font-size: var(--font-size-xs);
    line-height: 1.4;
    color: var(--color-muted);
  }

  .theme-css {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-separator);
  }

  .theme-css-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .theme-css-code {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-family-mono);
    font-size: var(--sl-text-code-sm);
    overflow-x: auto;
  }

  .theme-previews {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .preview-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  /* Cards are white surfaces themselves; set them on the page color. */
  .preview-surface {
    padding: 1.25rem;
    border-radius: var(--radius-2xl);
    background: var(--color-bg);
  }

  :not(:defined) {
    visibility: hidden;
  }
</style>
