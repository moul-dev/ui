---
// Home-page kitchen sink: one live tile per sandbox category, each linking to
// the component pages in that category. Tiles mirror the sandbox's demo
// groups — white surfaces lifted by a soft shadow.
import { getCollection } from 'astro:content'
import { COMPONENT_CATEGORIES } from '../categories'

// This tsconfig doesn't load Starlight's locals types; name the field used.
const { locale } = (
  Astro.locals as { starlightRoute: { locale: string | undefined } }
).starlightRoute
const entries = new Map(
  (await getCollection('docs')).map((entry) => [entry.id, entry]),
)

const categories = COMPONENT_CATEGORIES.map((category, index) => ({
  ...category,
  index: index + 1,
  links: category.slugs.map((slug) => {
    const id = locale ? `${locale}/${slug}` : slug
    const entry = entries.get(id) ?? entries.get(slug)
    return { href: `/${id}/`, title: entry?.data.title ?? slug }
  }),
}))

// Property-only demo data, assigned client-side from data-props.
const statProps = { sparklineData: [24, 30, 28, 38, 44, 52] }
const logsProps = {
  raw: [
    '2026/10/19 09:14:02 INFO Starting server addr="http://localhost:8090"',
    '2026/10/19 09:14:09 INFO HTTP request method="GET" path="/api/health" status=200',
    '2026/10/19 09:14:12 WARN Slow query detected table="orders" duration="1.42s"',
    '2026/10/19 09:14:21 ERRO Webhook delivery failed error="context deadline exceeded"',
  ].join('\n'),
}
---

<div class="showcase not-content">
  {
    categories.map(({ key, index, label, links }) => (
      <article class="tile" id={key}>
        <header class="tile-header">
          <h3 class="tile-title">
            <a href={links[0]?.href}>
              {index}. {label}
            </a>
          </h3>
          <span class="tile-count">{links.length}</span>
        </header>

        <div class="tile-demo">
          {key === 'actions' && (
            <>
              <div class="demo-row">
                <moul-button variant="primary">Primary</moul-button>
                <moul-button variant="secondary">Secondary</moul-button>
                <moul-button variant="outline">Outline</moul-button>
              </div>
              <div class="demo-row">
                <moul-toggle-button-group selected-key="week">
                  <moul-toggle-button value="day">Day</moul-toggle-button>
                  <moul-toggle-button value="week">Week</moul-toggle-button>
                  <moul-toggle-button value="month">Month</moul-toggle-button>
                </moul-toggle-button-group>
              </div>
            </>
          )}

          {key === 'surfaces' && (
            <>
              <moul-alert
                tone="success"
                title="Deployment successful"
                description="Release v2026.10 is live on the edge."
              />
              <div class="demo-row">
                <moul-avatar-group max="3">
                  <moul-avatar name="Sarah Chen" size="sm" />
                  <moul-avatar name="Marcus Brody" size="sm" />
                  <moul-avatar name="Elena Rostova" size="sm" />
                  <moul-avatar name="Devon Vance" size="sm" />
                </moul-avatar-group>
                <moul-badge tone="primary">Primary</moul-badge>
                <moul-badge tone="success" is-dot>
                  Live
                </moul-badge>
                <moul-kbd>⌘K</moul-kbd>
              </div>
            </>
          )}

          {key === 'overlays' && (
            <>
              <moul-breadcrumbs>
                <moul-breadcrumb-item href="#overlays">Workspace</moul-breadcrumb-item>
                <moul-breadcrumb-item is-current>Settings</moul-breadcrumb-item>
              </moul-breadcrumbs>
              <moul-tabs selected-key="overview">
                <moul-tab key="overview">Overview</moul-tab>
                <moul-tab key="analytics">Analytics</moul-tab>
                <moul-tab key="reports">Reports</moul-tab>
                <moul-tab-panel key="overview">Summary and recent activity.</moul-tab-panel>
                <moul-tab-panel key="analytics">Traffic and retention metrics.</moul-tab-panel>
                <moul-tab-panel key="reports">Audit reports and exports.</moul-tab-panel>
              </moul-tabs>
            </>
          )}

          {key === 'forms' && (
            <>
              <moul-text-field label="Display name" placeholder="Kim Ly" />
              <moul-switch is-checked>Enable telemetry</moul-switch>
              <moul-slider label="Throughput" value="42" />
            </>
          )}

          {key === 'charts' && (
            <>
              <moul-stat
                label="Monthly volume"
                value="52400"
                prefix="$"
                trend="up"
                trend-value="+14.8%"
                tone="success"
                data-props={JSON.stringify(statProps)}
              />
              <moul-percentage-bar label="Memory" value="74" />
            </>
          )}

          {key === 'blocks' && (
            <moul-logs
              show-levels
              max-height="9rem"
              data-props={JSON.stringify(logsProps)}
            />
          )}
        </div>

        <ul class="tile-links">
          {links.map(({ href, title }) => (
            <li>
              <a href={href}>{title}</a>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>

<script>
  import '@moul-dev/ui'

  // Arrays and objects are properties, not attributes.
  for (const el of document.querySelectorAll<HTMLElement>(
    '.showcase [data-props]',
  )) {
    Object.assign(el, JSON.parse(el.dataset.props ?? '{}'))
  }
</script>

<style>
  .showcase {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1rem;
    margin-block: 1.5rem 3rem;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-surface);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
    color: var(--color-fg);
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }

  .tile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tile-title {
    margin: 0;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tile-title a {
    color: inherit;
    text-decoration: none;
  }

  .tile-title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .tile-count {
    min-width: 1.25rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-2xl);
    background: var(--color-default);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.25rem;
    text-align: center;
  }

  .tile-demo {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    min-height: 9rem;
    font-size: var(--sl-text-sm);
  }

  /* Hide elements until Lit upgrades them so tiles never flash unstyled light DOM. */
  .tile-demo :not(:defined) {
    visibility: hidden;
  }

  .demo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .tile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0.875rem 0 0;
    border-top: 1px solid var(--color-separator);
    list-style: none;
  }

  .tile-links a {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-full);
    background: var(--color-default);
    color: var(--color-fg);
    font-size: var(--font-size-xs);
    line-height: 1.25rem;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-smooth);
  }

  .tile-links a:hover {
    background: var(--color-default-hover);
  }

  .tile-links a:focus-visible,
  .tile-title a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
