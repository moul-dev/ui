---
// A "liquid glass" feature card: a frosted panel whose hairline border and
// inner wash light up around the cursor, with a brand-tinted icon chip.
interface Props {
  title: string
  icon: keyof typeof ICONS
}

// Stroke icons drawn on a 24×24 grid.
const ICONS = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  droplet:
    '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  languages:
    '<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>',
}

const { title, icon } = Astro.props
---

<article class="feature-card">
  <div class="feature-panel">
    <span class="feature-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[icon]} />
    </span>
    <div class="feature-text">
      <h3 class="feature-title">{title}</h3>
      <div class="feature-body"><slot /></div>
    </div>
  </div>
</article>

<script>
  for (const card of document.querySelectorAll<HTMLElement>('.feature-card')) {
    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect()
      card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`)
      card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`)
    })
  }
</script>

<style>
  .feature-card {
    --mouse-x: 50%;
    --mouse-y: 50%;
    --glass-brand: light-dark(
      oklch(
        0.78 calc(0.16 * var(--brand-chroma-multiplier, 1)) var(--brand-hue, 250)
      ),
      oklch(
        0.82 calc(0.15 * var(--brand-chroma-multiplier, 1)) var(--brand-hue, 250)
      )
    );

    position: relative;
    overflow: hidden;
    padding: 1px;
    border-radius: 1rem;
    background: light-dark(rgb(229 231 235 / 0.35), rgb(63 63 70 / 0.25));
    box-shadow: light-dark(
      0 4px 30px rgb(0 0 0 / 0.02),
      0 4px 30px rgb(0 0 0 / 0.15)
    );
    transition: box-shadow 0.3s ease;
  }

  .feature-card:hover {
    box-shadow: light-dark(
      0 10px 40px rgb(0 0 0 / 0.05),
      0 10px 40px rgb(0 0 0 / 0.3)
    );
  }

  /* Cursor-following border: a radial wash masked down to the 1px ring. */
  .feature-card::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: radial-gradient(
      300px circle at var(--mouse-x) var(--mouse-y),
      color-mix(in oklab, var(--glass-brand) 55%, transparent),
      transparent 80%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-panel {
    position: relative;
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: calc(1rem - 1px);
    background: light-dark(rgb(255 255 255 / 0.55), rgb(15 15 17 / 0.5));
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  /* Inner wash that follows the cursor. */
  .feature-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      400px circle at var(--mouse-x) var(--mouse-y),
      light-dark(
        color-mix(in oklab, var(--glass-brand) 4%, transparent),
        color-mix(in oklab, var(--glass-brand) 7%, transparent)
      ),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .feature-card:hover .feature-panel::before {
    opacity: 1;
  }

  /* Hairline accent along the top edge. */
  .feature-panel::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--glass-brand) 55%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .feature-icon {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-lg);
    background: oklch(
      0.75 calc(0.14 * var(--brand-chroma-multiplier, 1)) var(--brand-hue, 250) /
        0.1
    );
    color: light-dark(
      oklch(
        0.55 calc(0.17 * var(--brand-chroma-multiplier, 1)) var(--brand-hue, 250)
      ),
      oklch(
        0.72 calc(0.16 * var(--brand-chroma-multiplier, 1)) var(--brand-hue, 250)
      )
    );
  }

  .feature-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-text {
    position: relative;
    min-width: 0;
  }

  .feature-title {
    margin: 0 0 0.375rem;
    color: var(--color-fg);
    font-size: var(--sl-text-base);
    font-weight: 600;
    line-height: 1.4;
  }

  .feature-body {
    color: var(--color-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.7;
  }

  .feature-body :global(p) {
    margin: 0;
  }

  .feature-body :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }

  .feature-body :global(code) {
    padding: 0.0625rem 0.3125rem;
    border-radius: var(--radius-md);
    background: var(--color-default);
    color: var(--color-fg);
    font-family: var(--font-family-mono);
    font-size: 0.85em;
  }
</style>
